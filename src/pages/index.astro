---
/**
 * HOMEPAGE — the approved bento design.
 * Markup and classes are unchanged from the prototype; only the links are
 * now real and the data comes from real frontmatter.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, CATEGORIES, type CategoryKey } from '../lib/posts';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await getPosts();

const latest = posts[0];
const smallOnes = posts.slice(1, 5);
const wideOnes = posts.slice(5, 8);

const total = posts.length;
const oldest = posts[posts.length - 1];
const fmt = (d: Date) => new Intl.DateTimeFormat('es-ES', { month: 'short', year: 'numeric' }).format(d);
const rangeFrom = fmt(oldest.pubDate);
const rangeTo = fmt(latest.pubDate);

const counts = posts.reduce((acc, p) => {
  acc[p.categoryKey] = (acc[p.categoryKey] ?? 0) + 1;
  return acc;
}, {} as Record<CategoryKey, number>);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} current="home">
  <main class="p-wrap" style="padding-top: clamp(1.5rem, 4vw, 2.75rem)">

    <!-- 1. HERO BENTO -->
    <section class="bento">
      <div class="cell span-7 row-2">
        <span class="hero__status">
          <span class="hero__dot"></span> Escribiendo el capítulo #{latest.chapter}
        </span>

        <p class="hero__kicker">Diario de una aprendiz de código</p>

        <h1 class="hero__title">
          Hola, soy<br /><em>Laura Montironi</em> <span class="hero__wave">👋</span>
        </h1>

        <p class="hero__text">
          Ex contadora, mamá y futura developer en construcción. Este es mi espacio
          para documentar mi cambio de carrera, mis aprendizajes y el caos mental
          de empezar de nuevo.
        </p>

        <div class="hero__actions">
          <a class="btn btn--pink" href="/blog/">Leer el blog →</a>
          <a class="btn btn--plain" href="/about/">Sobre mí</a>
        </div>
      </div>

      <div class="cell tone-pink span-5 cell--hover">
        <span class="monogram">LM</span>
        <h2 class="identity__name">Laura Montironi</h2>
        <p class="identity__role">Ex contadora pública, mamá y developer en construcción.</p>
        <div class="chips">
          <span class="chip">Backend</span>
          <span class="chip">Python</span>
          <span class="chip">Barcelona</span>
        </div>
      </div>

      <div class="cell tone-blue span-5 cell--hover">
        <span class="cell__label">Ahora mismo</span>
        <p style="font-family: var(--font-display); font-weight: 800; font-size: clamp(1.1rem, 1.9vw, 1.5rem); line-height: 1.15;">
          Dos semanas en mi nuevo trabajo y la sensación de estar aprendiendo más
          rápido que nunca.
        </p>
        <div class="chips">
          <span class="chip">Ruby</span>
          <span class="chip">RSpec</span>
          <span class="chip">Docker</span>
          <span class="chip">Jenkins</span>
        </div>
      </div>
    </section>

    <!-- 2. STATS / QUOTE STRIP -->
    <section class="bento" style="margin-top: var(--gap)">
      <div class="cell tone-yellow span-3">
        <span class="cell__label">Capítulos</span>
        <span class="stat__number">{total}</span>
        <p style="font-weight:600; font-size:0.88rem">
          artículos escritos entre {rangeFrom} y {rangeTo}
        </p>
      </div>

      <div class="cell tone-lilac span-5">
        <span class="cell__label">Por qué escribo esto</span>
        <p class="quote__text">
          “No es el blog de alguien que ya lo logró. Es el de alguien que está
          caminando el proceso, paso a paso.”
        </p>
        <p class="quote__by">— Sobre mí</p>
      </div>

      <div class="cell tone-mint span-4">
        <span class="cell__label">El recorrido</span>
        <p class="journey">
          🇦🇷 Córdoba <span class="journey__arrow">→</span> 🇪🇸 Barcelona
        </p>
        <ul class="timeline">
          <li>📊 Contadora Pública · UNC</li>
          <li>🎓 MBA · EAE Business School</li>
          <li>💻 Bootcamp · UpgradeHub</li>
          <li>🥊 Backend developer en una fintech</li>
        </ul>
      </div>
    </section>

    <!-- 3. CATEGORIES / TAGS -->
    <section class="section">
      <div class="section__head">
        <h2 class="section__title">Explorá por tema</h2>
        <a class="section__link" href="/blog/">Ver el archivo →</a>
      </div>

      <div class="cell span-12" style="display:block">
        <div class="cats">
          {Object.entries(CATEGORIES).map(([key, cat]) => (
            <a class={`cat ${cat.className}`} href={`/blog/?cat=${key}`}>
              <span aria-hidden="true">{cat.emoji}</span>
              {cat.label}
              <span class="cat__count">{counts[key as CategoryKey] ?? 0}</span>
            </a>
          ))}
        </div>

        <div class="tags" style="margin-top:1rem">
          {[...new Set(posts.flatMap((p) => p.tags))].slice(0, 16).map((t) => (
            <span class="tag">#{t}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. POSTS BENTO -->
    <section class="section">
      <div class="section__head">
        <h2 class="section__title">Últimos capítulos</h2>
        <a class="section__link" href="/blog/">Ver los {total} →</a>
      </div>

      <div class="bento">
        <PostCard post={latest} featured span="span-6" rowSpan tone="tone-coral" />
        {smallOnes.map((post) => <PostCard post={post} span="span-3" />)}
        {wideOnes.map((post, i) => (
          <PostCard post={post} span="span-4" tone={i === 1 ? 'tone-yellow' : ''} />
        ))}
      </div>
    </section>

    <!-- 5. CTA -->
    <section class="section">
      <div class="cell tone-ink span-12" style="align-items:center; text-align:center; gap:1rem">
        <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.4rem); max-width: 20ch">
          Aprendiendo a programar desde cero, sin rendirme
        </h2>
        <p style="max-width: 52ch; opacity: 0.8">
          Si algo de lo que leés te acompaña o te ayuda, entonces este blog ya
          cumplió su propósito.
        </p>
        <a class="btn btn--pink" href={latest.href}>Empezar por el último capítulo →</a>
      </div>
    </section>
  </main>
</BaseLayout>
