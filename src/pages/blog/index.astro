---
/**
 * ARCHIVE — /blog/
 * Same visual language as the homepage, one notch calmer: every article,
 * newest first, with client-side category filtering (no extra routes).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, CATEGORIES, type CategoryKey } from '../../lib/posts';

const posts = await getPosts();

const counts = posts.reduce((acc, p) => {
  acc[p.categoryKey] = (acc[p.categoryKey] ?? 0) + 1;
  return acc;
}, {} as Record<CategoryKey, number>);
---

<BaseLayout
  title="Todos los capítulos | Lau | Mi camino Dev-Blog"
  description="Todos los artículos del blog: el camino de contadora a desarrolladora backend, capítulo a capítulo."
  current="blog"
>
  <main class="p-wrap" style="padding-top: clamp(1.5rem, 4vw, 2.75rem)">
    <div class="archive__head">
      <h1 class="archive__title">Todos los <em>capítulos</em></h1>
      <p class="archive__lede">
        {posts.length} artículos, en orden. De las dudas iniciales al primer
        trabajo como backend developer.
      </p>
    </div>

    <div class="filters" role="group" aria-label="Filtrar por tema">
      <span class="filters__label">Filtrar</span>
      <button class="filter" type="button" data-filter="all" aria-pressed="true">
        Todos <span class="cat__count">{posts.length}</span>
      </button>
      {Object.entries(CATEGORIES).map(([key, cat]) => (
        <button
          class={`filter ${cat.filterClass}`}
          type="button"
          data-filter={key}
          aria-pressed="false"
        >
          <span aria-hidden="true">{cat.emoji}</span> {cat.label}
          <span class="cat__count">{counts[key as CategoryKey] ?? 0}</span>
        </button>
      ))}
    </div>

    <div class="bento" id="archive-grid">
      {posts.map((post, i) => (
        <PostCard
          post={post}
          span={post.featured ? 'span-6' : 'span-4'}
          tone={i % 7 === 1 ? 'tone-yellow' : i % 11 === 4 ? 'tone-mint' : ''}
        />
      ))}
      <p class="archive__empty" id="archive-empty" hidden>
        No hay artículos en este tema todavía.
      </p>
    </div>
  </main>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('.filter');
  const cards = document.querySelectorAll('#archive-grid .post');
  const empty = document.getElementById('archive-empty');

  function apply(filter) {
    let shown = 0;
    cards.forEach((card) => {
      const match = filter === 'all' || card.dataset.category === filter;
      card.hidden = !match;
      if (match) shown++;
    });
    if (empty) empty.hidden = shown !== 0;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
  }

  buttons.forEach((b) => b.addEventListener('click', () => {
    apply(b.dataset.filter);
    const url = new URL(window.location.href);
    if (b.dataset.filter === 'all') url.searchParams.delete('cat');
    else url.searchParams.set('cat', b.dataset.filter);
    history.replaceState({}, '', url);
  }));

  // Honour ?cat=codigo arriving from the homepage pills.
  const initial = new URL(window.location.href).searchParams.get('cat');
  if (initial) apply(initial);
</script>
