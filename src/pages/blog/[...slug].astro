---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPosts, getRoutableEntries } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const all = await getRoutableEntries();

  // Index of prev/next, based on real articles only (portada is excluded).
  const order = new Map(posts.map((p, i) => [p.id, i]));

  return all.map((entry) => {
    const i = order.get(entry.id);
    const has = i !== undefined;
    return {
      params: { slug: entry.id },
      props: {
        entry,
        // newer posts sit at a LOWER index
        next: has && posts[i - 1] ? { href: posts[i - 1].href, title: posts[i - 1].title } : null,
        prev: has && posts[i + 1] ? { href: posts[i + 1].href, title: posts[i + 1].title } : null,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings} prev={prev} next={next}>
  <Content />
</ArticleLayout>
