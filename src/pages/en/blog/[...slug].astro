---
import { render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getPosts, getRoutableEntries, getTranslationMap, slugOf } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts('en');
  const all = await getRoutableEntries('en');
  const translations = await getTranslationMap();
  const order = new Map(posts.map((p, i) => [p.id, i]));

  return all.map((entry) => {
    const i = order.get(entry.id);
    const has = i !== undefined;
    return {
      params: { slug: slugOf(entry) },
      props: {
        entry,
        altHref: translations.get(entry.data.translationKey)?.es ?? null,
        next: has && posts[i - 1] ? { href: posts[i - 1].href, title: posts[i - 1].title } : null,
        prev: has && posts[i + 1] ? { href: posts[i + 1].href, title: posts[i + 1].title } : null,
      },
    };
  });
}

const { entry, prev, next, altHref } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} lang="en" headings={headings} prev={prev} next={next} altHref={altHref}>
  <Content />
</ArticleLayout>
