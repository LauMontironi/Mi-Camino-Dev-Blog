---
import LangSwitch from './LangSwitch.astro';
import { ROUTES, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  current?: 'home' | 'blog' | 'about';
  altHref?: string | null;
}
const { lang, current = 'home', altHref = null } = Astro.props;
const t = useTranslations(lang);

const links = [
  { key: 'home',  label: t('nav.home'),  href: ROUTES.home[lang] },
  { key: 'blog',  label: t('nav.blog'),  href: ROUTES.blog[lang] },
  { key: 'about', label: t('nav.about'), href: ROUTES.about[lang] },
];
---

<header class="p-header">
  <div class="p-wrap">
    <nav class="p-nav" aria-label={t('nav.primary')}>
      <a class="p-logo" href={ROUTES.home[lang]}>
        <span class="p-logo__mark" aria-hidden="true">LM</span>
        <span>mi camino dev</span>
      </a>

      <div class="p-links" id="p-links" data-open="false">
        {links.map((l) => (
          <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
        ))}
      </div>

      <div class="p-nav__right">
        <LangSwitch lang={lang} altHref={altHref} />
        <button class="p-burger" type="button" aria-expanded="false" aria-controls="p-links">
          {t('nav.menu')}
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const burger = document.querySelector('.p-burger');
  const menu = document.getElementById('p-links');
  if (burger && menu) {
    burger.addEventListener('click', () => {
      const open = menu.dataset.open === 'true';
      menu.dataset.open = String(!open);
      burger.setAttribute('aria-expanded', String(!open));
    });
  }
</script>
