---
import LangSwitch from './LangSwitch.astro';

interface Props {
  current?: 'home' | 'blog' | 'about';
}
const { current = 'home' } = Astro.props;

const links = [
  { key: 'home',  label: 'Inicio',   href: '/' },
  { key: 'blog',  label: 'Blog',     href: '/blog/' },
  { key: 'about', label: 'Sobre mí', href: '/about/' },
];
---

<header class="p-header">
  <div class="p-wrap">
    <nav class="p-nav" aria-label="Principal">
      <a class="p-logo" href="/">
        <span class="p-logo__mark" aria-hidden="true">LM</span>
        <span>mi camino dev</span>
      </a>

      <div class="p-links" id="p-links" data-open="false">
        {links.map((l) => (
          <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        ))}
      </div>

      <div class="p-nav__right">
        <LangSwitch />
        <button class="p-burger" type="button" aria-expanded="false" aria-controls="p-links">
          Menú
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const burger = document.querySelector('.p-burger');
  const menu = document.getElementById('p-links');
  if (burger && menu) {
    burger.addEventListener('click', () => {
      const open = menu.dataset.open === 'true';
      menu.dataset.open = String(!open);
      burger.setAttribute('aria-expanded', String(!open));
    });
  }
</script>
