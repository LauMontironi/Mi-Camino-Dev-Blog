---
/**
 * Only rendered for long TECHNICAL posts (see the rule in the article page).
 * Personal, narrative articles deliberately get no ToC — it would make them
 * read like documentation.
 */
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{items.length > 0 && (
  <details class="toc" open>
    <summary>En este artículo</summary>
    <ol>
      {items.map((h) => (
        <li><a href={`#${h.slug}`}>{h.text}</a></li>
      ))}
    </ol>
  </details>
)}
