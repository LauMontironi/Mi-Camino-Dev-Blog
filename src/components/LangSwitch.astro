---
/**
 * ES / EN switch.
 * `altHref` is resolved from real data (fixed routes, or a translationKey
 * pair for articles). When there is no counterpart the other language is
 * shown but disabled — it never links to a guessed or dead URL.
 */
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  altHref?: string | null;
}
const { lang, altHref = null } = Astro.props;
const t = useTranslations(lang);
const other: Locale = lang === 'es' ? 'en' : 'es';
const labels: Record<Locale, string> = { es: 'ES', en: 'EN' };
---

<div class="p-lang" role="group" aria-label={t('lang.group')}>
  <span aria-current="true" aria-pressed="true">{labels[lang]}</span>

  {altHref ? (
    <a href={altHref} aria-pressed="false" lang={other} hreflang={other}>{labels[other]}</a>
  ) : (
    <button type="button" aria-pressed="false" aria-disabled="true" title={t('lang.unavailable')}>
      {labels[other]}
    </button>
  )}
</div>
