---
import type { Post } from '../lib/posts';
import { formatDate, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  post: Post;
  lang: Locale;
  featured?: boolean;
  tone?: string;
  span?: string;
  rowSpan?: boolean;
}

const { post, lang, featured = false, tone = '', span = 'span-4', rowSpan = false } = Astro.props;
const t = useTranslations(lang);

const classes = [
  'cell', 'post', span,
  featured ? 'post--featured' : '',
  rowSpan ? 'row-2' : '',
  tone,
].filter(Boolean).join(' ');
---

<a class={classes} href={post.href} data-category={post.categoryKey}>
  <div>
    <div class="post__top">
      {post.chapter && <span class="post__chapter">#{post.chapter}</span>}
      <span class="post__cat">{post.category.label}</span>
    </div>

    <h3 class="post__title">{post.title}</h3>

    {post.description && <p class="post__desc">{post.description}</p>}

    {featured && post.tags.length > 0 && (
      <div class="tags" style="margin-top:0.8rem">
        {post.tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
    )}
  </div>

  <div class="post__foot">
    <span>{formatDate(post.pubDate, lang)} · {post.minutes} {t('article.readingTime')}</span>
    <span class="post__arrow" aria-hidden="true">→</span>
  </div>
</a>
