---
import type { ImageMetadata } from 'astro';
import SiteHead from '../components/SiteHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  current?: 'home' | 'blog' | 'about';
  bodyClass?: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  /** Same page in the other language, or null when it does not exist. */
  altHref?: string | null;
}

const {
  lang, title, description, current = 'home',
  bodyClass = '', image, type, altHref = null,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <SiteHead lang={lang} title={title} description={description} image={image} type={type} altHref={altHref} />
  </head>
  <body class={bodyClass}>
    <Header lang={lang} current={current} altHref={altHref} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
