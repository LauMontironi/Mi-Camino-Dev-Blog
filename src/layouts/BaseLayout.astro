---
import type { ImageMetadata } from 'astro';
import SiteHead from '../components/SiteHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'blog' | 'about';
  bodyClass?: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
}

const { title, description, current = 'home', bodyClass = '', image, type } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SiteHead title={title} description={description} image={image} type={type} />
  </head>
  <body class={bodyClass}>
    <Header current={current} />
    <slot />
    <Footer />
  </body>
</html>
